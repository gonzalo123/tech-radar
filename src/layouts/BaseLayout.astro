---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
const { title, description, image } = Astro.props;
---
<html lang="es"><head><meta charset="UTF-8" /><SEO title={title} description={description} image={image} /></head><body><header><div class="wrap masthead"><a class="brand" href={import.meta.env.BASE_URL}>gonzalo123 <span>Tech Radar</span></a><nav><a href={`${import.meta.env.BASE_URL}news/`}>Noticias</a><a href={`${import.meta.env.BASE_URL}archive/`}>Archivo</a><a href={`${import.meta.env.BASE_URL}tag/agents/`}>AI</a><a href={`${import.meta.env.BASE_URL}category/devtools/`}>Código</a><a href={`${import.meta.env.BASE_URL}rss.xml`}>RSS</a></nav></div></header><slot /><footer><div class="wrap">gonzalo123 Tech Radar · Un radar personal sobre tecnología, software y sistemas.</div></footer></body></html>
