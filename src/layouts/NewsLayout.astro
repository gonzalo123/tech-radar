---
import BaseLayout from './BaseLayout.astro';
const { entry, body } = Astro.props; const { data } = entry;
---
<BaseLayout title={data.title} description={data.description}><main><article class="article"><script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'NewsArticle', headline:data.title, description:data.description, datePublished:data.date.toISOString(), mainEntityOfPage:Astro.url.toString(), publisher:{'@type':'Organization',name:'gonzalo123 Tech Radar'}, author:{'@type':'Organization',name:data.source} })} /><div class="eyebrow">{data.category}</div><h1>{data.title}</h1><p class="meta">{data.date.toLocaleDateString('es-ES',{dateStyle:'long'})} · {data.source}</p><div class="tags">{data.tags.map((tag:string)=><a class="tag" href={`${import.meta.env.BASE_URL}tag/${tag.toLowerCase()}/`}>#{tag}</a>)}</div><section class="article-summary" aria-label="Resumen"><div class="eyebrow">En 30 segundos</div><p>{data.description}</p></section><div class="prose"><slot /></div><p class="meta">Fuente original: <a href={data.source_url} target="_blank" rel="noopener noreferrer">{data.source}</a></p></article></main></BaseLayout>
