---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {published,categories,slug} from '../../lib/news'; const items=await published(); const months=new Map<string,typeof items>(); for(const item of items){const key=item.data.date.toLocaleDateString('es-ES',{year:'numeric',month:'long'}); if(!months.has(key))months.set(key,[]);months.get(key)!.push(item)}
---
<BaseLayout><main><div class="wrap"><div class="edition"><span>Hemeroteca</span><span>{items.length} noticias</span></div><h1>Archivo</h1><p class="intro">Encuentra una noticia por palabra clave, tema o mes.</p><label class="search-label" for="news-search">Buscar en el histórico</label><div class="search-box"><input id="news-search" type="search" placeholder="Ej.: agentes, Python, cloud..." autocomplete="off"/><span id="search-count" class="meta"></span></div><div id="search-results" class="archive-results" aria-live="polite"></div><div id="archive-list">{[...months].map(([month,news])=><section class="section-rule archive-month"><h2>{month}</h2><div class="archive-links">{news.map(item=><a class="archive-item" href={`${import.meta.env.BASE_URL}news/${slug(item)}/`}><span class="badge">{item.data.category}</span><strong>{item.data.title}</strong><span class="meta">{item.data.date.toLocaleDateString('es-ES')} · {item.data.source}</span></a>)}</div></section>)}</div></div></main><script define:vars={{base:import.meta.env.BASE_URL}}>
const input=document.querySelector('#news-search'),results=document.querySelector('#search-results'),archive=document.querySelector('#archive-list'),count=document.querySelector('#search-count');let index=[];fetch(`${base}search-index.json`).then(r=>r.json()).then(data=>index=data);input?.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();if(!q){results.innerHTML='';archive.hidden=false;count.textContent='';return}archive.hidden=true;const found=index.filter(n=>[n.title,n.description,n.category,n.source,...n.tags].join(' ').toLowerCase().includes(q));count.textContent=`${found.length} resultado${found.length===1?'':'s'}`;results.innerHTML=found.map(n=>`<a class="archive-item" href="${base}${n.url}"><span class="badge">${n.category}</span><strong>${n.title}</strong><span class="meta">${new Date(n.date).toLocaleDateString('es-ES')} · ${n.source}</span></a>`).join('')||'<p class="meta">No se han encontrado noticias.</p>';});
</script></BaseLayout>
