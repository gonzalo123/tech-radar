---
import BaseLayout from '../layouts/BaseLayout.astro'; import NewsCard from '../components/NewsCard.astro'; import { published, categories, editorialOrder } from '../lib/news';
const items=await published(); const ordered=editorialOrder(items); const featured=ordered.find(x=>x.data.placement==='lead') ?? ordered.find(x=>x.data.featured) ?? ordered[0]; const secondary=ordered.filter(x=>x.id!==featured?.id && x.data.placement!=='brief').slice(0,3); const briefs=ordered.filter(x=>x.id!==featured?.id && x.data.placement==='brief').slice(0,4); const used=new Set([featured?.id,...secondary.map(x=>x.id),...briefs.map(x=>x.id)]); const cats=categories(items); const sectionItems=(category:string)=>ordered.filter(x=>x.data.category===category && !used.has(x.id)).slice(0,3);
---
<BaseLayout><main><div class="wrap"><div class="edition"><span>Edición digital</span><span>{new Date().toLocaleDateString('es-ES',{dateStyle:'long'})}</span></div><section class="front-grid" aria-label="Portada">{featured && <article class="lead-story"><div class="eyebrow">{featured.data.breaking?'Última hora · ':''}{featured.data.category}</div><h1><a href={`${import.meta.env.BASE_URL}news/${featured.id.replace(/\.md$/,'')}/`}>{featured.data.title}</a></h1><p>{featured.data.description}</p><p class="meta">{featured.data.date.toLocaleDateString('es-ES',{dateStyle:'long'})} · {featured.data.source}</p></article>}<div class="secondary-column">{secondary.map(entry=><NewsCard entry={entry}/>)}</div>{briefs.length>0&&<div class="briefs">{briefs.map(entry=><article class="brief"><div class="eyebrow">{entry.data.category}</div><h3><a href={`${import.meta.env.BASE_URL}news/${entry.id.replace(/\.md$/,'')}/`}>{entry.data.title}</a></h3><p class="meta">{entry.data.date.toLocaleDateString('es-ES')}</p></article>)}</div>}</section>{cats.map(category=>{const stories=sectionItems(category);return stories.length>0&&<section class="section-rule"><h2>{category}</h2><div class="section-grid">{stories.map(entry=><NewsCard entry={entry}/>)}</div></section>})}<section class="section-rule"><h2>Últimas noticias</h2><div class="grid">{ordered.filter(x=>!used.has(x.id)).slice(0,6).map(entry=><NewsCard entry={entry}/>)}</div></section></div></main></BaseLayout>
